# =================================================================
#  CLOUDPULSE MONITORING PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# =================================================================

# Backend Node server configuration
NODE_ENV=development
PORT=5001

# PostgreSQL Database Connection URI (Prisma ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloudpulse?schema=public

# JSON Web Token Secret
JWT_SECRET=cloudpulse_super_secret_jwt_key_2026_prod

# Redis Cache URI (temporary telemetry storage and websocket room states)
REDIS_URL=redis://localhost:6379

# Client Address (CORS whitelist validation)
CLIENT_URL=http://localhost:3000

# Metric settings
MONITOR_INTERVAL=5000

# NextJS Frontend environment variables
NEXT_PUBLIC_API_URL=http://localhost:5001/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5001
