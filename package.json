{
  "name": "cloudpulse-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Real-Time Infrastructure Monitoring Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "type-check": "npm run type-check --workspace=packages/shared && npm run type-check --workspace=apps/api && npm run type-check --workspace=apps/web",
    "test": "npm run test --workspace=apps/api",
    "prisma:generate": "npx prisma generate",
    "prisma:push": "npx prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "prisma": "^5.14.0",
    "typescript": "^5.4.5"
  }
}
